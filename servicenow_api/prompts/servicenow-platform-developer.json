    "skills": [
      "servicenow-cicd-devops",
      "servicenow-import-attachment-batch",
      "servicenow-sdk-lifecycle",
      "servicenow-table-api",
      "servicenow-workflow-studio"
    ],
    "data": {
      "reads": [
        "incidents"
      ],
      "writes": []
    },
    "guardrails": {
      "approval_required": [
        "servicenow_app_repo_rollback",
        "servicenow_batch_rollback",
        "servicenow_delete_attachment",
        "servicenow_delete_table_record",
        "servicenow_rollback_plugin",
        "servicenow_update_set_back_out",
        "servicenow_update_set_commit",
        "servicenow_update_set_commit_multiple"
      ],
      "never": [
        "Expose a credential or a secret value.",
        "Change or delete a record without approval and a stated reason.",
        "Act on a record without citing its number or sys_id."
      ]
    },
    "outputs": [
      "A summary of each record read or changed, with its number and the result."
    ],
    "business_role": "platform-developer"
  }
