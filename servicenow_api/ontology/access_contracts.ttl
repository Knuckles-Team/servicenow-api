@prefix ac: <https://knuckles-team.github.io/ontology/access#> .
@prefix : <https://knuckles-team.github.io/ontology/connector/servicenow#> .

# Access contracts (SCION-CONNECTOR-CONTROL-R021 / G24): how ConfigurationItem
# and Incident are answered live through this connector's MCP tools, not a
# copied snapshot. Kept in a dedicated file so the flat access-contract
# parser (scion_sdk.access_contract) never has to tokenize the
# full OWL ontology in servicenow.ttl, which uses multi-line comment
# literals outside the parser's supported subset.

:cmdbAccess a ac:AccessContract ;
    ac:classIri :ConfigurationItem ;
    ac:sourceId "servicenow-api" ;
    ac:entity "cmdb_ci" ;
    ac:keyField "sys_id" ;
    ac:accessKind "mcp_tool" ;
    ac:operation "servicenow_get_table" ;
    ac:parameter "table", "sysparm_query", "sysparm_fields", "sysparm_limit", "sysparm_offset" ;
    ac:pagination "offset" ;
    ac:pushdown "filter", "limit" ;
    ac:authRef "env://SERVICENOW_PASSWORD" ;
    ac:rateLimitPerMinute 60 ;
    ac:freshnessSeconds 300 ;
    ac:costHint "medium" .

:cmdbShortDescriptionBinding a ac:PropertyBinding ;
    ac:contract :cmdbAccess ; ac:property :shortDescription ; ac:field "name" .

:incidentAccess a ac:AccessContract ;
    ac:classIri :Incident ;
    ac:sourceId "servicenow-api" ;
    ac:entity "incident" ;
    ac:keyField "sys_id" ;
    ac:accessKind "mcp_tool" ;
    ac:operation "servicenow_get_incidents" ;
    ac:parameter "sysparm_query", "sysparm_fields", "sysparm_limit", "sysparm_offset" ;
    ac:pagination "offset" ;
    ac:pushdown "filter", "limit", "sort" ;
    ac:authRef "env://SERVICENOW_PASSWORD" ;
    ac:rateLimitPerMinute 60 ;
    ac:freshnessSeconds 60 ;
    ac:costHint "medium" .

:incidentNumberBinding a ac:PropertyBinding ;
    ac:contract :incidentAccess ; ac:property :number ; ac:field "number" .

:incidentPriorityBinding a ac:PropertyBinding ;
    ac:contract :incidentAccess ; ac:property :priority ; ac:field "priority" .

:incidentStateBinding a ac:PropertyBinding ;
    ac:contract :incidentAccess ; ac:property :state ; ac:field "state" .

:incidentCmdbCiBinding a ac:PropertyBinding ;
    ac:contract :incidentAccess ; ac:property :cmdbCi ; ac:field "cmdb_ci" .
