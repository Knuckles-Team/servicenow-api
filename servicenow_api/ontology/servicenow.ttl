@prefix fibo-fi: <https://spec.edmcouncil.org/fibo/ontology/FBC/FinancialInstruments/FinancialInstruments/> .
@prefix core: <https://knuckles-team.github.io/ontology/core#> .
@prefix fibo-org: <https://spec.edmcouncil.org/fibo/ontology/FND/Organizations/Organizations/> .
@prefix bibo: <http://purl.org/ontology/bibo/> .
@prefix time: <http://www.w3.org/2006/time#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix dc: <http://purl.org/dc/terms/> .
@prefix : <https://knuckles-team.github.io/ontology/connector/servicenow#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:assignedToGroup a owl:ObjectProperty ;
    rdfs:label "assigned to group" ;
    rdfs:comment "Links an Incident to the AssignmentGroup that works it (incident.assignment_group): the steward of the incident." ;
    rdfs:domain core:Incident ;
    rdfs:range core:AssignmentGroup .

:impactsConfigurationItem a owl:ObjectProperty ;
    rdfs:label "impacts configuration item" ;
    rdfs:comment "Links an Incident to the ConfigurationItem it is raised against (incident.cmdb_ci)." ;
    rdfs:subPropertyOf core:affects ;
    rdfs:domain core:Incident ;
    rdfs:range core:ConfigurationItem .

:ciOwnedBy a owl:ObjectProperty ;
    rdfs:label "CI owned by" ;
    rdfs:comment "Links a ConfigurationItem to the Person accountable for it (cmdb_ci.owned_by)." ;
    rdfs:subPropertyOf core:ownedBy ;
    rdfs:domain core:ConfigurationItem ;
    rdfs:range core:Person .

:managedByGroup a owl:ObjectProperty ;
    rdfs:label "managed by group" ;
    rdfs:comment "Links a ConfigurationItem to the AssignmentGroup that manages it (cmdb_ci.managed_by_group): its steward." ;
    rdfs:domain core:ConfigurationItem ;
    rdfs:range core:AssignmentGroup .

:supportedByGroup a owl:ObjectProperty ;
    rdfs:label "supported by group" ;
    rdfs:comment "Links a ConfigurationItem to the AssignmentGroup that supports it (cmdb_ci.support_group)." ;
    rdfs:domain core:ConfigurationItem ;
    rdfs:range core:AssignmentGroup .

:cmdbCi a owl:DatatypeProperty ;
    rdfs:label "configuration item reference" ;
    rdfs:comment "Reference to the configuration item an Incident is raised against (incident.cmdb_ci)." ;
    rdfs:domain core:Incident ;
    rdfs:range xsd:string .

:number a owl:DatatypeProperty ;
    rdfs:label "number" ;
    rdfs:comment "Human-readable ServiceNow record number (e.g. INC0010001)." ;
    rdfs:range xsd:string .

:shortDescription a owl:DatatypeProperty ;
    rdfs:label "short description" ;
    rdfs:comment "Brief summary of the ITSM record or configuration item." ;
    rdfs:range xsd:string .

<https://knuckles-team.github.io/ontology/connector/servicenow> a owl:Ontology ;
    rdfs:label "ServiceNow ITSM Ontology" ;
    rdfs:comment """ServiceNow IT Service Management extensions: incidents,
    changes, CMDB configuration items and CI relationships, and Technology
    Reference Model (TRM) standards, categories and requests, with their
    affected-CI, owner and technology-usage relationships.

    CONCEPT:KG-2.9 — Self-registering source extractors.""" .

:KnowledgeArticle a owl:Class ;
    rdfs:subClassOf core:Document ;
    rdfs:label "Knowledge Article" ;
    rdfs:comment """A ServiceNow knowledge-base article (kb_knowledge table),
    ingested as a :Document carrying its text and source_uri. Referenced via the
    ``subtype`` property on the ingested :Document node.""" .

# --- CMDB: configuration item subtypes (cmdb_ci and its child tables) ------------

# Shared concepts Server, Application and BusinessService are owned by the medulla
# ontology and other packs and are referenced here, never redeclared. The ServiceNow CMDB
# subtypes below add the system-specific configuration-item parentage.

:CmdbServer a owl:Class ;
    rdfs:subClassOf core:ConfigurationItem, core:Server ;
    rdfs:label "CMDB Server" ;
    rdfs:comment "A physical or virtual server CI (ServiceNow cmdb_ci_server)." .

:CmdbApplication a owl:Class ;
    rdfs:subClassOf core:ConfigurationItem, core:Application ;
    rdfs:label "CMDB Application" ;
    rdfs:comment "An installed or running application CI (ServiceNow cmdb_ci_appl)." .

:CmdbBusinessService a owl:Class ;
    rdfs:subClassOf core:ConfigurationItem, core:BusinessService ;
    rdfs:label "CMDB Business Service" ;
    rdfs:comment "A service delivered to the business, built from CIs (ServiceNow cmdb_ci_service)." .

:CIRelationship a owl:Class ;
    rdfs:subClassOf core:JunctionLink ;
    rdfs:label "CI Relationship" ;
    rdfs:comment """A typed, directed relationship between two configuration items, reified
    with its type (ServiceNow cmdb_rel_ci: parent, child, type such as Depends on::Used by,
    Runs on::Runs, Hosted on::Hosts).""" .

# --- ITSM: change requests ----------------------------------------------------------

# --- TRM: technology reference model -------------------------------------------------

:TRMCategory a owl:Class ;
    rdfs:subClassOf core:Concept ;
    rdfs:label "TRM Category" ;
    rdfs:comment "A category that groups TRM standards (ServiceNow sn_apm_trm_standards_category)." .

:TRMLifecycle a owl:Class ;
    rdfs:subClassOf core:TechnologyStandard ;
    rdfs:label "TRM Lifecycle" ;
    rdfs:comment """A versioned lifecycle entry of a TRM standard with a phase and start and end
    dates (ServiceNow sn_apm_trm_standards_product_lifecycle).""" .

:TRMTechnicalDebt a owl:Class ;
    rdfs:subClassOf core:Concept ;
    rdfs:label "TRM Technical Debt" ;
    rdfs:comment """Technical debt of a business application on a TRM standard in a given phase
    (ServiceNow sn_apm_trm_standards_technical_debt).""" .

:TechnologyRequest a owl:Class ;
    rdfs:subClassOf core:TRMRequest ;
    rdfs:label "Technology Request" ;
    rdfs:comment """A request to adopt, change or retire a technology (ServiceNow
    sn_apm_trm_product_request).""" .

:LifecycleRequest a owl:Class ;
    rdfs:subClassOf :TechnologyRequest ;
    rdfs:label "Lifecycle Request" ;
    rdfs:comment """A request for a version lifecycle entry of a technology (ServiceNow
    sn_apm_trm_product_lifecycle_request).""" .

# --- Edges and properties ------------------------------------------------------------

:inCategory a owl:ObjectProperty ;
    rdfs:label "in category" ;
    rdfs:comment "Links a TRMStandard to its TRMCategory." ;
    rdfs:domain core:TRMStandard ;
    rdfs:range :TRMCategory .

:requestsTechnology a owl:ObjectProperty ;
    rdfs:label "requests technology" ;
    rdfs:comment "Links a TechnologyRequest to the TRMStandard it asks to adopt or change." ;
    rdfs:domain :TechnologyRequest ;
    rdfs:range core:TRMStandard .

:relationshipParent a owl:ObjectProperty ;
    rdfs:label "relationship parent" ;
    rdfs:comment "The parent CI of a CIRelationship (cmdb_rel_ci.parent)." ;
    rdfs:domain :CIRelationship ;
    rdfs:range core:ConfigurationItem .

:relationshipChild a owl:ObjectProperty ;
    rdfs:label "relationship child" ;
    rdfs:comment "The child CI of a CIRelationship (cmdb_rel_ci.child)." ;
    rdfs:domain :CIRelationship ;
    rdfs:range core:ConfigurationItem .

:lifecycleOf a owl:ObjectProperty ;
    rdfs:label "lifecycle of" ;
    rdfs:comment "Links a TRMLifecycle entry to the TRMStandard it versions (trm_product)." ;
    rdfs:domain :TRMLifecycle ;
    rdfs:range core:TRMStandard .

:debtOn a owl:ObjectProperty ;
    rdfs:label "debt on" ;
    rdfs:comment "Links a TRMTechnicalDebt row to the TRMStandard it is debt on." ;
    rdfs:domain :TRMTechnicalDebt ;
    rdfs:range core:TRMStandard .

:debtOfApplication a owl:ObjectProperty ;
    rdfs:label "debt of application" ;
    rdfs:comment "Links a TRMTechnicalDebt row to the BusinessApplication carrying it." ;
    rdfs:domain :TRMTechnicalDebt ;
    rdfs:range core:BusinessApplication .

:productionApproved a owl:DatatypeProperty ;
    rdfs:label "production approved" ;
    rdfs:comment "Whether a TRMPhase permits production use (production_approved)." ;
    rdfs:domain core:TRMPhase ;
    rdfs:range xsd:boolean .
